[node name="MemoryAfterBattle" parent="." unique_id=1656148041 instance=ExtResource("17_ohitc")]
position = Vector2(635, 145)
memory_text = "Крики, запах гари, пламя пожирает дома. Старуха в чёрном платке прижимает к себе мёртвого внука и смотрит прямо на тебя. Тот же взгляд – без ненависти, только вопрос."
dialogue_key = "segment3_torches"

[node name="MemoryFlashback" parent="." unique_id=96640115 instance=ExtResource("17_ohitc")]
position = Vector2(919, 222)
memory_text = "Ты сражаешься на автомате, не понимая, что происходит. Отбиваешься, уклоняешься, наносишь удары… "
dialogue_key = "segment2_flashback"

